# Copiar este archivo a .env y completar los valores.
# El archivo .env esta en .gitignore - NUNCA commitearlo.

# ─── Perfil ────────────────────────────────────────────────────────────
# Perfil activo de Spring. Local: dejar vacio. Docker: 'docker'.
# En Render usar 'prod'.
SPRING_PROFILES_ACTIVE=

# ─── Base de datos (solo perfil prod / Render) ─────────────────────────
# JDBC de Postgres. En Render tomar la "Internal Database URL" y
# reescribirla como jdbc:postgresql://<host>:<port>/<db>
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ─── IA ────────────────────────────────────────────────────────────────
# API key de Google Gemini. Obtener en https://aistudio.google.com/apikey
# El backend acepta GEMINI_API_KEY o API_KEY_GEMINI.
GEMINI_API_KEY=

# ─── Autenticacion ─────────────────────────────────────────────────────
# Client ID de Google para Login con Google.
GOOGLE_CLIENT_ID=

# Secreto para firmar los tokens de la app. En prod usar un valor largo y
# aleatorio (NO dejar el default de desarrollo).
AGENDIFY_AUTH_SECRET=

# ─── Seed / Bootstrap ──────────────────────────────────────────────────
# Si es true, carga datos de ejemplo al arrancar. Poner en false en prod
# cuando no quieras re-sembrar.
AGENDIFY_BOOTSTRAP_ENABLED=true

# ─── Integraciones ─────────────────────────────────────────────────────
# URL del webhook de n8n para el evento "turno confirmado".
INTEGRATIONS_N8N_TURNO_CONFIRMADO_URL=
